# Railway → Postgres service → Variables → DATABASE_URL (interna) ou DATABASE_PUBLIC_URL.
# Se usar a URL pública (proxy.rlwy.net), acrescente ?sslmode=require no final.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Qualquer string aleatória longa (ex: openssl rand -hex 32)
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Credenciais do único admin (login do /admin)
ADMIN_EMAIL=admin@karagua.com.br
ADMIN_PASSWORD=sua-senha-segura

# Origens permitidas no CORS, separadas por vírgula (vazio = todas)
CORS_ORIGIN=https://karagua-production.up.railway.app,http://localhost:5173

PORT=4000

# Token pessoal do NASA Earthdata Login (crie uma conta grátis em
# urs.earthdata.nasa.gov, gere o token em Profile → Generate Token).
# Necessário só pro /mangrove-heightmap (TanDEM-X 2015, dataset protegido) —
# sem ele o endpoint responde 502 com uma mensagem clara, o resto da API
# funciona normalmente. Tokens da Earthdata Login expiram (~2 meses); precisa
# gerar um novo e atualizar essa variável periodicamente.
NASA_EARTHDATA_TOKEN=
